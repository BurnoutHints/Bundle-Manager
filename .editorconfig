root = true

[*.cs]
end_of_line = crlf
insert_final_newline = true
charset = utf-8
indent_style = space
indent_size = 4
dotnet_diagnostic.CA1416.severity = none

# Code style
csharp_style_namespace_declarations = file_scoped
csharp_style_var_for_built_in_types = false
csharp_style_var_when_type_is_apparent = false
csharp_style_var_elsewhere = false
csharp_style_implicit_object_creation_when_type_is_apparent = true
dotnet_style_prefer_collection_expression = when_types_loosely_match
dotnet_style_collection_initializer = true
csharp_prefer_simple_using_statement = true
csharp_style_pattern_matching_over_as_with_null_check = true
csharp_style_pattern_matching_over_is_with_cast_check = true
csharp_style_prefer_not_pattern = true
csharp_style_inlined_variable_declaration = true
csharp_prefer_simple_default_expression = true
dotnet_style_coalesce_expression = true
dotnet_style_null_propagation = true
csharp_style_prefer_index_operator = true
csharp_style_prefer_range_operator = true
dotnet_style_predefined_type_for_locals_parameters_members = true
dotnet_style_predefined_type_for_member_access = true
dotnet_diagnostic.IDE0005.severity = suggestion # unnecessary using
dotnet_diagnostic.IDE0008.severity = suggestion # explicit type instead of var
dotnet_diagnostic.IDE0018.severity = suggestion # inline out variable
dotnet_diagnostic.IDE0019.severity = suggestion # pattern matching over as + null check
dotnet_diagnostic.IDE0020.severity = suggestion # pattern matching over is + cast
dotnet_diagnostic.IDE0028.severity = suggestion # collection initializer
dotnet_diagnostic.IDE0029.severity = suggestion # ?? over null check
dotnet_diagnostic.IDE0031.severity = suggestion # ?. over null check
dotnet_diagnostic.IDE0034.severity = suggestion # default literal
dotnet_diagnostic.IDE0049.severity = suggestion # language keywords over framework type names
dotnet_diagnostic.IDE0056.severity = suggestion # index operator
dotnet_diagnostic.IDE0057.severity = suggestion # range operator
dotnet_diagnostic.IDE0063.severity = suggestion # using declaration
dotnet_diagnostic.IDE0083.severity = suggestion # is not pattern
dotnet_diagnostic.IDE0090.severity = suggestion # target-typed new
dotnet_diagnostic.IDE0161.severity = suggestion # file-scoped namespace
dotnet_diagnostic.IDE0300.severity = suggestion # collection expressions
dotnet_diagnostic.IDE0301.severity = suggestion
dotnet_diagnostic.IDE0303.severity = suggestion
dotnet_diagnostic.IDE0304.severity = suggestion
dotnet_diagnostic.IDE0305.severity = suggestion

[*.Designer.cs]
generated_code = true

[*.csproj]
indent_style = space
indent_size = 2
